# Copy this file to .env.local and fill in the values.
# On your host, add the same values as environment variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where messages from the contact and booking forms are delivered.
CONTACT_TO_EMAIL=

# Optional. Sender shown on the emails; needs a domain verified in Resend.
# Without it, Resend only delivers to the email on your Resend account.
CONTACT_FROM_EMAIL=
